{
    "name": "@luogu-saver/markdown-renderer",
    "version": "1.0.0",
    "description": "Markdown renderer shared by Luogu Saver packages.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./worker": {
            "types": "./dist/worker.d.ts",
            "import": "./dist/worker/index.mjs",
            "default": "./dist/worker/index.mjs"
        }
    },
    "repository": "https://github.com/laikit-dev/luogu-saver",
    "files": [
        "dist"
    ],
    "author": "Federico2903",
    "license": "MIT",
    "scripts": {
        "clean": "rimraf dist",
        "build:types": "tsc",
        "build:node": "esbuild src/index.ts --bundle --platform=node --format=cjs --packages=external --target=node22 --outfile=dist/index.js",
        "build:worker": "esbuild src/worker.ts --bundle --platform=browser --format=esm --splitting --conditions=worker --target=es2020 --minify --entry-names=index --chunk-names=chunks/[name]-[hash] --out-extension:.js=.mjs --outdir=dist/worker",
        "build": "npm run clean && npm run build:types && npm run build:node && npm run build:worker",
        "test": "npm run build && node --test test/*.test.mjs"
    },
    "dependencies": {
        "@shikijs/core": "^3.23.0",
        "@shikijs/engine-oniguruma": "^3.23.0",
        "@shikijs/langs": "^3.23.0",
        "@shikijs/rehype": "^3.20.0",
        "@shikijs/themes": "^3.23.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-katex": "^7.0.1",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "rehype-slug": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-directive": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "remark-smartypants": "^3.0.2",
        "shiki": "^3.17.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.0.0",
        "vfile": "^6.0.3"
    },
    "devDependencies": {
        "@types/hast": "^3.0.4",
        "@types/node": "^24.10.0",
        "esbuild": "^0.27.7",
        "rimraf": "^6.1.3",
        "typescript": "~5.9.3"
    }
}
